# Main entrypoint of the workflow. 
# Please follow the best practices: 
# https://snakemake.readthedocs.io/en/stable/snakefiles/best_practices.html,
# in particular regarding the standardized folder structure mentioned there. 
import pandas as pd
import numpy as np

configfile: "config/config.yaml"

MEAN_NUC_ILLUMINA="300"
MEAN_NUC_NANOPORE="30000"
MODEL="/human_NA12878_DNA_FAB49712_guppy/training"

wildcard_constraints:
    technology="|".join(["nanopore", "illumina"]),
    model="|".join(["/human_NA12878_DNA_FAB49712_guppy/training", ""]),

include: "rules/reference.smk"
include: "rules/create_circle_sequences.smk"
include: "rules/simulate_reads.smk"
include: "rules/quality_control.smk"
include: "rules/create_samples_units_sheets.smk"

def final_output():
    final_output = []
    for g in lookup(dpath="groups", within=config):
        final_output.extend(
            expand(
                [
                    "results/samples/{group}/illumina/{group}.{alias}.mean_fragment_nucleotides_{mean_nuc}{read}.fq.gz",
                    "results/quality_control/{group}/illumina/{group}.{alias}.mean_fragment_nucleotides_{mean_nuc}.bam",
                ],
                group=g,
                alias=lookup(dpath=f"groups/{g}", within=config),
                mean_nuc=[MEAN_NUC_ILLUMINA],
                read=[".1", ".2"],
            )
        )
        final_output.extend(
            expand(
                [
                    "results/samples/{group}/nanopore{model}/{group}.{alias}.mean_fragment_nucleotides_{mean_nuc}.fq.gz",
                    "results/quality_control/{group}/nanopore{model}/{group}.{alias}.mean_fragment_nucleotides_{mean_nuc}.bam",
                ],
                group=g,
                model=[MODEL],
                alias=lookup(dpath=f"groups/{g}", within=config),
                mean_nuc=[MEAN_NUC_NANOPORE],
            )
        )
        final_output.extend([
            "results/samples/samples.tsv",
            "results/samples/units.tsv",
        ])
    return final_output

rule all:
    input: final_output()
